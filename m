 	char *tmp;							\
 									\
 	mutex_lock(&opts->lock);					\
-	if (opts->refcnt)						\
+	if (opts->refcnt) {						\
+		ret = -EBUSY;						\
 		goto end;						\
+	}								\
+									\
+	if (len && page[len - 1] == '\n')				\
+		len--;							\
 									\
 	tmp = kstrndup(page, len, GFP_KERNEL);				\
-	if (tmp) {							\
+	if (!tmp) {							\
 		ret = -ENOMEM;						\
 		goto end;						\
 	}								\
@@ -922,7 +927,6 @@ static ssize_t f_uac1_opts_##name##_store(struct config_item *item,	\
 		kfree(opts->name);					\
 	opts->name##_alloc = true;					\
 	opts->name = tmp;						\
-	ret = len;							\
 									\
 end:									\
 	mutex_unlock(&opts->lock);					\
